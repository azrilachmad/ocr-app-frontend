# =============================================================================
# Frontend (OCR App) Environment Variables — Production
# =============================================================================
# Copy this file to .env and fill in the values
# These variables are used at BUILD TIME (Vite inlines them during build)
# =============================================================================

# Backend API URL
# Development : http://localhost:3001/api
# Production  : https://api.yourdomain.com/api  (separate API domain)
#             : https://ocr.yourdomain.com/api   (same domain via nginx proxy)
VITE_API_BASE_URL=https://api.yourdomain.com/api

# =============================================================================
# Google Drive Integration (Optional)
# =============================================================================
# To enable "Import from Google Drive" on the upload page:
# 1. Go to https://console.cloud.google.com/
# 2. Enable "Google Picker API" and "Google Drive API"
# 3. Create OAuth 2.0 Client ID (Web Application type)
#    - Add authorized JS origins: http://localhost:5173 (dev), https://yourdomain.com (prod)
# 4. Create API Key and restrict to Google Picker API only
# 5. Fill in the values below
#
# If left empty, the Google Drive button will not appear on the upload page.
# =============================================================================
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
